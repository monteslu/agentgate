<!DOCTYPE html>
<html>
<head>
  <title>agentgate - <%= title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
  <link rel="stylesheet" href="/public/style.css">
  <link rel="stylesheet" href="/public/mobile.css">
  <% if (locals.includeSocket) { %>
  <script src="/socket.io/socket.io.js"></script>
  <% } %>
  <% if (locals.includeMarkdown) { %>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.min.js"></script>
  <% } %>
</head>
<body>
  <%- include('../partials/nav', { pendingQueueCount: locals.pendingQueueCount || 0, pendingMessagesCount: locals.pendingMessagesCount || 0, messagingMode: locals.messagingMode || 'off' }) %>

  <main class="container">
    <%- content %>
  </main>

  <%- include('../partials/scripts') %>
</body>
</html>
