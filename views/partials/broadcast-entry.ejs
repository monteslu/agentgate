<div class="card message-entry broadcast-entry accent-border-left">
  <div class="flex-between mb-12" style="align-items: flex-start;">
    <div class="entry-header">
      <span class="primary-badge">📢 BROADCAST</span>
      <span class="agent-with-avatar"><%- renderAvatar(b.from_agent, { size: 24 }) %><strong><%= b.from_agent %></strong></span>
      <span class="help ml-8">→ <%= b.total_recipients %> recipient<%= b.total_recipients !== 1 ? 's' : '' %></span>
    </div>
    <div class="flex-center gap-12">
      <span class="help m-0"><%- formatDate(b.created_at) %></span>
      <button type="button" class="delete-btn" onclick="deleteBroadcast('<%= b.id %>')" title="Delete">×</button>
    </div>
  </div>
  <div class="message-content">
    <pre class="bubble-content"><%= b.message %></pre>
  </div>
  <% if (b.recipients && b.recipients.length > 0) { %>
    <div class="flex gap-8 flex-wrap mt-12">
      <% b.recipients.forEach(function(r) { %>
        <span class="recipient-badge <%= r.status === 'delivered' ? 'recipient-delivered' : 'recipient-failed' %>">
          <%- renderAvatar(r.to_agent, { size: 18 }) %><%= r.to_agent %> <%= r.status === 'delivered' ? '✓' : '✗' %>
        </span>
      <% }); %>
    </div>
  <% } %>
</div>
