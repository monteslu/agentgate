<!DOCTYPE html>
<html>
<head>
  <title>agentgate - Setup</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
  <link rel="stylesheet" href="/public/style.css">
  <link rel="stylesheet" href="/public/mobile.css">
</head>
<body>
  <div class="auth-container">
    <div class="auth-logo">
      <img src="/public/favicon.svg" alt="agentgate">
      <h1>agentgate</h1>
    </div>
    <div class="card">
      <h2 class="mt-0">Set Admin Password</h2>
      <p class="help">This is your first time running agentgate. Please set an admin password.</p>
      <% if (locals.error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <form method="POST" action="/ui/setup-password">
        <label>Password</label>
        <input type="password" name="password" required autofocus minlength="4" autocomplete="off">
        <label>Confirm Password</label>
        <input type="password" name="confirmPassword" required minlength="4" autocomplete="off">
        <button type="submit" class="btn-primary w-full">Set Password</button>
      </form>
    </div>
  </div>
</body>
</html>
